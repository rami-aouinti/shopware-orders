<sw-page class="lieferzeiten-notification-toggle-list">
    <template #smart-bar-header>
        <h2>{{ $t('lieferzeiten.lms.navigation.notificationToggles') }}</h2>
    </template>

    <template #content>
        <sw-tabs class="sw-mb-16">
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.channelSettings' }" title="Lieferzeiten-Management-System">
                Lieferzeiten-Management-System
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.syncConfiguration' }" title="Sync settings">
                Sync settings
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.taskAssignmentRules' }" :title="$t('lieferzeiten.lms.navigation.taskAssignmentRules')">
                {{ $t('lieferzeiten.lms.navigation.taskAssignmentRules') }}
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.notificationToggles' }" :title="$t('lieferzeiten.lms.navigation.notificationToggles')">
                {{ $t('lieferzeiten.lms.navigation.notificationToggles') }}
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.statistics' }" title="Statistiken">
                Statistiken
            </sw-tabs-item>
        </sw-tabs>

        <sw-card :isLoading="isLoading" :title="$t('lieferzeiten.lms.notificationMatrix.title')">
            <sw-alert variant="info" appearance="default" :showIcon="true">
                {{ $t('lieferzeiten.lms.notificationMatrix.source') }}
                <code>(triggerKey, channel, salesChannelId)</code>.
            </sw-alert>

            <sw-alert variant="info" appearance="default" :showIcon="true">
                {{ $t('lieferzeiten.lms.notificationMatrix.emailOnlyHint') }}
            </sw-alert>

            <sw-alert v-if="invalidEntries.length" variant="warning" appearance="default" :showIcon="true">
                {{ $t('lieferzeiten.lms.notificationMatrix.invalidEntries', { count: invalidEntries.length }) }}
            </sw-alert>

            <div class="lieferzeiten-notification-toggle-list__toolbar">
                <sw-single-select
                    v-model:value="selectedSalesChannelId"
                    class="lieferzeiten-notification-toggle-list__filter"
                    :label="$t('lieferzeiten.lms.notificationMatrix.salesChannelFilterLabel')"
                    :options="salesChannelFilterOptions"
                />

                <sw-button size="small" variant="primary" :disabled="isLoading" @click="onReload">
                    {{ $t('lieferzeiten.lms.notificationMatrix.reload') }}
                </sw-button>
            </div>

            <div class="lieferzeiten-notification-toggle-list__scope-grid">
                <sw-card
                    v-for="scope in visibleScopes"
                    :key="scope.id"
                    class="lieferzeiten-notification-toggle-list__scope-card"
                    :title="scope.name"
                >
                    <template #toolbar>
                        <div class="lieferzeiten-notification-toggle-list__quick-actions">
                            <sw-button
                                size="x-small"
                                variant="primary"
                                :disabled="isLoading || !hasEditAccess"
                                @click="setScopeState(scope.id, true)"
                            >
                                {{ $t('lieferzeiten.lms.notificationMatrix.enableAll') }}
                            </sw-button>
                            <sw-button
                                size="x-small"
                                :disabled="isLoading || !hasEditAccess"
                                @click="setScopeState(scope.id, false)"
                            >
                                {{ $t('lieferzeiten.lms.notificationMatrix.disableAll') }}
                            </sw-button>
                        </div>
                    </template>

                    <div class="lieferzeiten-notification-toggle-list__trigger-list">
                        <div
                            v-for="triggerKey in triggerOptions"
                            :key="`${scope.id}-${triggerKey}`"
                            class="lieferzeiten-notification-toggle-list__trigger-item"
                        >
                            <span class="lieferzeiten-notification-toggle-list__trigger-label">{{ getTriggerLabel(triggerKey) }}</span>
                            <sw-switch-field
                                :value="getToggleValue(triggerKey, channelOptions[0], scope.id === 'global' ? null : scope.id)"
                                :disabled="!hasEditAccess || isCellDisabled(triggerKey, channelOptions[0], scope.id === 'global' ? null : scope.id)"
                                @update:value="onToggleChanged(triggerKey, channelOptions[0], scope.id === 'global' ? null : scope.id, $event)"
                            />
                        </div>
                    </div>
                </sw-card>
            </div>
        </sw-card>
    </template>
</sw-page>

<sw-page class="lieferzeiten-sync-settings">
    <template #smart-bar-header>
        <h2>Lieferzeiten sync settings</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button-process variant="primary" :isLoading="isSaving" @click="onSave">
            {{ $tc('global.default.save') }}
        </sw-button-process>
    </template>

    <template #content>
        <sw-tabs class="sw-mb-16">
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.channelSettings' }" title="Lieferzeiten-Management-System">
                Lieferzeiten-Management-System
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.syncConfiguration' }" title="Sync settings">
                Sync settings
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.taskAssignmentRules' }" :title="$tc('lieferzeiten.lms.navigation.taskAssignmentRules')">
                {{ $tc('lieferzeiten.lms.navigation.taskAssignmentRules') }}
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.notificationToggles' }" :title="$tc('lieferzeiten.lms.navigation.notificationToggles')">
                {{ $tc('lieferzeiten.lms.navigation.notificationToggles') }}
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.statistics' }" title="Statistiken">
                Statistiken
            </sw-tabs-item>
        </sw-tabs>
        <sw-card-view>
            <sw-card :isLoading="isLoading" title="Demo Daten" class="sw-mb-16">
                <lieferzeiten-demo-data-button />
            </sw-card>

            <sw-card
                v-for="group in groups"
                :key="group.title"
                :title="group.title"
                :isLoading="isLoading"
                class="sw-mb-16"
            >
                <template v-for="field in group.fields">
                    <sw-textarea-field
                        v-if="field.type === 'textarea'"
                        :key="field.key"
                        v-model:value="configValues[field.key]"
                        :label="field.label"
                        :helpText="field.helpText"
                        class="sw-mb-16"
                    />

                    <sw-password-field
                        v-else-if="field.type === 'password'"
                        :key="field.key"
                        v-model:value="configValues[field.key]"
                        :label="field.label"
                        :helpText="field.helpText"
                        class="sw-mb-16"
                    />

                    <sw-text-field
                        v-else
                        :key="field.key"
                        v-model:value="configValues[field.key]"
                        :label="field.label"
                        :helpText="field.helpText"
                        class="sw-mb-16"
                    />
                </template>
            </sw-card>
        </sw-card-view>
    </template>
</sw-page>

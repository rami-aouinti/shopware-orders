{% block lieferzeiten_statistics %}
    <div class="lieferzeiten-statistics">
        <sw-container columns="1fr 1fr auto" gap="16px" class="lieferzeiten-statistics__filters">
            <sw-single-select
                v-model:value="selectedPeriod"
                :label="$t('lieferzeiten.statistics.periodLabel')"
                :options="periodOptions"
                labelProperty="label"
                valueProperty="value"
            />
            <sw-single-select
                v-model:value="selectedChannel"
                :label="$t('lieferzeiten.statistics.channelLabel')"
                :options="channelOptions"
                labelProperty="label"
                valueProperty="value"
            />
            <sw-container
                v-if="selectedPeriod === 'custom'"
                columns="1fr 1fr"
                gap="12px"
                class="lieferzeiten-statistics__custom-range"
            >
                <sw-datepicker
                    v-model:value="customFrom"
                    :label="$t('lieferzeiten.statistics.customRange.from')"
                />
                <sw-datepicker
                    v-model:value="customTo"
                    :label="$t('lieferzeiten.statistics.customRange.to')"
                />
            </sw-container>
            <sw-button variant="primary" @click="exportCsv">
                {{ $t('lieferzeiten.statistics.exportCsv') }}
            </sw-button>
        </sw-container>

        <sw-loader v-if="isLoading" />

        <sw-empty-state
            v-else-if="loadError"
            :title="$t('lieferzeiten.loading.errorTitle')"
            :description="$t('lieferzeiten.loading.errorDescription')"
        />

        <template v-else>
        <sw-container columns="repeat(3, minmax(0, 1fr))" gap="16px" class="lieferzeiten-statistics__metrics">
            <sw-card :title="$t('lieferzeiten.statistics.open')">
                <div class="lieferzeiten-statistics__metric">{{ metrics.open }}</div>
            </sw-card>
            <sw-card :title="$t('lieferzeiten.statistics.overdueShipping')">
                <div class="lieferzeiten-statistics__metric">{{ metrics.overdueShipping }}</div>
            </sw-card>
            <sw-card :title="$t('lieferzeiten.statistics.overdueDelivery')">
                <div class="lieferzeiten-statistics__metric">{{ metrics.overdueDelivery }}</div>
            </sw-card>
        </sw-container>

        <div class="lieferzeiten-statistics__insight-grid">
            <section class="lieferzeiten-statistics__panel">
                <header class="lieferzeiten-statistics__panel-header">
                    <h3>{{ $t('lieferzeiten.statistics.chartTitle') }}</h3>
                </header>
                <div v-if="channelChartData.length" class="lieferzeiten-statistics__chart">
                    <div v-for="item in channelChartData" :key="item.channel" class="lieferzeiten-statistics__chart-row">
                        <span>{{ item.channel }}</span>
                        <div class="lieferzeiten-statistics__bar-wrap">
                            <div class="lieferzeiten-statistics__bar" :style="{ width: getChartBarWidth(item.value) }"></div>
                        </div>
                        <strong>{{ item.value }}</strong>
                    </div>
                </div>
                <div v-else class="lieferzeiten-statistics__empty">{{ $t('lieferzeiten.emptyState.description') }}</div>
            </section>

            <section class="lieferzeiten-statistics__panel">
                <header class="lieferzeiten-statistics__panel-header">
                    <h3>{{ $t('lieferzeiten.statistics.timelineTitle') }}</h3>
                </header>
                <div v-if="timelineSeries.length > 1" class="lieferzeiten-statistics__timeline-chart">
                    <svg viewBox="0 0 100 60" preserveAspectRatio="none" class="lieferzeiten-statistics__timeline-svg">
                        <path :d="timelineChartPaths.areaPath" class="lieferzeiten-statistics__timeline-area" />
                        <path :d="timelineChartPaths.linePath" class="lieferzeiten-statistics__timeline-line" />
                    </svg>
                    <div class="lieferzeiten-statistics__timeline-axis">
                        <span>{{ formatTimelineLabel(timelineSeries[0].date) }}</span>
                        <span>{{ formatTimelineLabel(timelineSeries[timelineSeries.length - 1].date) }}</span>
                    </div>
                </div>
                <div v-else-if="timelineSeries.length === 1" class="lieferzeiten-statistics__timeline-fallback">
                    <strong>{{ timelineSeries[0].value }}</strong>
                    <span>{{ formatTimelineLabel(timelineSeries[0].date) }}</span>
                </div>
                <div v-else class="lieferzeiten-statistics__empty">{{ $t('lieferzeiten.statistics.timelineEmptyDescription') }}</div>
            </section>
        </div>

        <sw-container columns="repeat(3, minmax(0, 1fr))" gap="16px" class="lieferzeiten-statistics__breakdowns">
            <sw-card :title="$t('lieferzeiten.statistics.eventTypeBreakdownTitle')">
                <div v-if="eventTypeBreakdown.length" class="lieferzeiten-statistics__chart lieferzeiten-statistics__breakdown-chart">
                    <div v-for="item in eventTypeBreakdown" :key="`event-type-${item.eventType}`" class="lieferzeiten-statistics__chart-row lieferzeiten-statistics__breakdown-row">
                        <span>{{ formatEventTypeLabel(item.eventType) }}</span>
                        <div class="lieferzeiten-statistics__bar-wrap">
                            <div class="lieferzeiten-statistics__bar" :style="{ width: getBreakdownBarWidth(item.value, eventTypeBreakdownMaxValue) }"></div>
                        </div>
                        <strong>{{ item.value }}</strong>
                    </div>
                </div>
                <sw-empty-state
                    v-else
                    :title="$t('lieferzeiten.emptyState.title')"
                    :description="$t('lieferzeiten.emptyState.description')"
                />
            </sw-card>

            <sw-card :title="$t('lieferzeiten.statistics.criticalStatusTitle')">
                <div v-if="criticalStatusBreakdown.length" class="lieferzeiten-statistics__chart lieferzeiten-statistics__breakdown-chart">
                    <div v-for="item in criticalStatusBreakdown" :key="`critical-status-${item.statusKey}`" class="lieferzeiten-statistics__chart-row lieferzeiten-statistics__breakdown-row">
                        <span>{{ formatCriticalStatusLabel(item.statusKey) }}</span>
                        <div class="lieferzeiten-statistics__bar-wrap">
                            <div class="lieferzeiten-statistics__bar lieferzeiten-statistics__bar--critical" :style="{ width: getBreakdownBarWidth(item.value, criticalStatusBreakdownMaxValue) }"></div>
                        </div>
                        <strong>{{ item.value }}</strong>
                    </div>
                </div>
                <sw-empty-state
                    v-else
                    :title="$t('lieferzeiten.emptyState.title')"
                    :description="$t('lieferzeiten.emptyState.description')"
                />
            </sw-card>

            <sw-card :title="$t('lieferzeiten.statistics.channelAnomaliesTitle')">
                <div v-if="channelAnomalies.length" class="lieferzeiten-statistics__chart lieferzeiten-statistics__breakdown-chart">
                    <div v-for="item in channelAnomalies" :key="`channel-anomaly-${item.sourceSystem}`" class="lieferzeiten-statistics__chart-row lieferzeiten-statistics__breakdown-row">
                        <div class="lieferzeiten-statistics__anomaly-labels">
                            <span>{{ item.sourceSystem }}</span>
                            <small>{{ formatCriticalStatusLabel(item.topStatus) }}</small>
                        </div>
                        <div class="lieferzeiten-statistics__bar-wrap">
                            <div class="lieferzeiten-statistics__bar lieferzeiten-statistics__bar--anomaly" :style="{ width: getBreakdownBarWidth(item.value, channelAnomaliesMaxValue) }"></div>
                        </div>
                        <strong>{{ item.value }}</strong>
                    </div>
                </div>
                <sw-empty-state
                    v-else
                    :title="$t('lieferzeiten.emptyState.title')"
                    :description="$t('lieferzeiten.emptyState.description')"
                />
            </sw-card>
        </sw-container>


        <section class="lieferzeiten-statistics__panel lieferzeiten-statistics__activity-panel">
            <header class="lieferzeiten-statistics__panel-header">
                <h3>{{ $t('lieferzeiten.statistics.tableTitle') }}</h3>
            </header>
            <div class="lieferzeiten-statistics__table-scroll">
                <table class="lieferzeiten-statistics__table">
                    <thead>
                        <tr>
                            <th>{{ $t('lieferzeiten.table.orderNumber') }}</th>
                            <th>{{ $t('lieferzeiten.table.domain') }}</th>
                            <th>{{ $t('lieferzeiten.table.status') }}</th>
                            <th>{{ $t('lieferzeiten.statistics.activityDate') }}</th>
                            <th>{{ $t('lieferzeiten.statistics.promisedDate') }}</th>
                            <th>{{ $t('lieferzeiten.statistics.actionsColumn') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="item in filteredOrders" :key="item.id">
                            <td>{{ item.orderNumber }}</td>
                            <td>{{ item.domain }}</td>
                            <td>
                                <span class="lieferzeiten-statistics__status" :class="{ 'is-overdue': item.status === $t('lieferzeiten.statistics.status.overdue') }">{{ item.status }}</span>
                            </td>
                            <td>{{ formatDate(item.eventAt) }}</td>
                            <td>{{ formatDate(item.promisedAt) }}</td>
                            <td>
                                <div class="lieferzeiten-statistics__actions">
                                    <button
                                        v-for="action in resolveActivityActions(item)"
                                        :key="`${item.id}-${action.id}`"
                                        class="lieferzeiten-statistics__action-btn"
                                        :class="{ 'is-disabled': action.disabled || action.isLoading }"
                                        :disabled="action.disabled || action.isLoading"
                                        @click="action.onClick && action.onClick()"
                                    >
                                        {{ action.isLoading ? '...' : action.label }}
                                    </button>
                                    <button class="lieferzeiten-statistics__action-btn lieferzeiten-statistics__action-btn--ghost" @click="onDrilldown(item)">
                                        {{ $t('lieferzeiten.statistics.drilldown') }}
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="lieferzeiten-statistics__table-pagination">
                <button class="lieferzeiten-statistics__pager-btn" :disabled="activitiesPage <= 1" @click="onPageChange(activitiesPage - 1)">{{ $t('global.default.previous') }}</button>
                <span>{{ activitiesPage }} / {{ totalPages }} ({{ activitiesTotal }})</span>
                <button class="lieferzeiten-statistics__pager-btn" :disabled="activitiesPage >= totalPages" @click="onPageChange(activitiesPage + 1)">{{ $t('global.default.next') }}</button>
                <button class="lieferzeiten-statistics__pager-btn lieferzeiten-statistics__pager-btn--ghost" @click="reloadActivityPage">{{ $t('global.default.refresh') }}</button>
            </div>
        </section>

        <sw-modal
            v-if="selectedActivity"
            :title="$t('lieferzeiten.statistics.drilldownTitle')"
            @modal-close="closeDrilldown"
        >
            <p><strong>{{ $t('lieferzeiten.table.orderNumber') }}:</strong> {{ selectedActivity.orderNumber }}</p>
            <p><strong>{{ $t('lieferzeiten.table.domain') }}:</strong> {{ selectedActivity.domain }}</p>
            <p><strong>{{ $t('lieferzeiten.table.status') }}:</strong> {{ selectedActivity.status }}</p>
            <p><strong>{{ $t('lieferzeiten.statistics.activityDate') }}:</strong> {{ formatDate(selectedActivity.eventAt) }}</p>
            <p><strong>{{ $t('lieferzeiten.statistics.promisedDate') }}:</strong> {{ formatDate(selectedActivity.promisedAt) }}</p>
        </sw-modal>
        </template>
    </div>
{% endblock %}

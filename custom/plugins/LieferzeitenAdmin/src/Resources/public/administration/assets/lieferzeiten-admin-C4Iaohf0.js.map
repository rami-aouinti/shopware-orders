<sw-page class="lieferzeiten-task-assignment-rule-list">
    <template #smart-bar-header>
        <h2>{{ $tc('lieferzeiten.lms.navigation.taskAssignmentRules') }}</h2>
    </template>

    <template #smart-bar-actions>
        <button v-if="hasEditAccess" class="lza-btn lza-btn--primary" :disabled="isLoading" @click="onCreate">
            Neu
        </button>
    </template>

    <template #content>
        <div class="lza-settings-nav">
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.channelSettings' }" :to="{ name: 'lieferzeiten.settings.channelSettings' }">Lieferzeiten-Management-System</router-link>
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.syncConfiguration' }" :to="{ name: 'lieferzeiten.settings.syncConfiguration' }">Synchronisations-Einstellungen</router-link>
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.taskAssignmentRules' }" :to="{ name: 'lieferzeiten.settings.taskAssignmentRules' }">{{ $tc('lieferzeiten.lms.navigation.taskAssignmentRules') }}</router-link>
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.notificationToggles' }" :to="{ name: 'lieferzeiten.settings.notificationToggles' }">{{ $tc('lieferzeiten.lms.navigation.notificationToggles') }}</router-link>
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.statistics' }" :to="{ name: 'lieferzeiten.settings.statistics' }">Statistiken</router-link>
        </div>

        <div class="lza-task-rule-layout">
            <section class="lza-intro-panel">
                <h3>Task assignment rules</h3>
                <p>
                    Die Demo-Daten in dieser Tabelle stammen aus dem Backend-Seeder
                    <strong>DemoDataSeederService</strong> via l'endpoint
                    <code>POST /api/_action/lieferzeiten/demo-data</code>.
                    Demo-Regeln verwenden das Präfix <code>demo_</code>.
                </p>
            </section>

            <section class="lza-rules-panel" :class="{ 'is-loading': isLoading }">
                <div class="lza-rules-toolbar">
                    <div class="lza-counter">{{ total }} Regel(n)</div>
                    <div class="lza-toolbar-actions">
                        <button class="lza-btn" :disabled="isLoading" @click="getList">Aktualisieren</button>
                        <button v-if="hasEditAccess" class="lza-btn lza-btn--primary" :disabled="isLoading" @click="onCreate">Neue Regel</button>
                    </div>
                </div>

                <div v-if="!rules.length" class="lza-empty-state">
                    Keine Regeln gefunden. Bitte prüfen Sie, ob die Demo-Daten erfolgreich angelegt wurden.
                </div>

                <div v-else class="lza-rule-table" role="table" aria-label="Aufgaben-Zuweisungsregeln">
                    <div class="lza-rule-header" role="row">
                        <span>Name</span>
                        <span>Status</span>
                        <span>Trigger *</span>
                        <span>Regel</span>
                        <span>Zuweisungstyp *</span>
                        <span>Zuständig *</span>
                        <span>Priority</span>
                        <span>Aktiv</span>
                        <span>Zuletzt geändert</span>
                        <span>Aktionen</span>
                    </div>

                    <div v-for="rule in rules" :key="rule.id" class="lza-rule-row" role="row">
                        <input v-model="rule.name" type="text" :disabled="!hasEditAccess" />
                        <input v-model="rule.status" type="text" :disabled="!hasEditAccess" />
                        <input v-model="rule.triggerKey" type="text" required :disabled="!hasEditAccess" />
                        <input v-model="rule.ruleId" type="text" :disabled="!hasEditAccess" />
                        <input v-model="rule.assigneeType" type="text" required :disabled="!hasEditAccess" />
                        <input v-model="rule.assigneeIdentifier" type="text" required :disabled="!hasEditAccess" />
                        <input v-model.number="rule.priority" type="number" :disabled="!hasEditAccess" />
                        <label class="lza-checkbox-cell">
                            <input v-model="rule.active" type="checkbox" :disabled="!hasEditAccess" />
                            <span>{{ rule.active ? 'Ja' : 'Nein' }}</span>
                        </label>
                        <div class="lza-last-change">
                            <div>{{ formatDate(rule.lastChangedAt) }}</div>
                            <small>{{ rule.lastChangedBy || '—' }}</small>
                        </div>
                        <div class="lza-actions">
                            <button class="lza-btn lza-btn--primary" :disabled="!hasEditAccess || isLoading" @click="onSaveRule(rule)">Speichern</button>
                            <button class="lza-btn lza-btn--danger" :disabled="!hasEditAccess || isLoading" @click="onDeleteRule(rule)">Löschen</button>
                        </div>
                    </div>
                </div>

                <div class="lza-pagination">
                    <button class="lza-btn" :disabled="page <= 1 || isLoading" @click="onPageChange({ page: page - 1, limit })">Zurück</button>
                    <span>Seite {{ page }}</span>
                    <button class="lza-btn" :disabled="(page * limit) >= total || isLoading" @click="onPageChange({ page: page + 1, limit })">Weiter</button>
                </div>
            </section>
        </div>
    </template>
</sw-page>

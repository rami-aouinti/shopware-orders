<sw-page class="lieferzeiten-task-assignment-rule-list">
    <template #smart-bar-header>
        <h2>{{ $tc('lieferzeiten.lms.navigation.taskAssignmentRules') }}</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button v-if="hasEditAccess" variant="primary" @click="onCreate">Neu</sw-button>
    </template>

    <template #content>
        <sw-tabs class="sw-mb-16">
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.channelSettings' }" title="Lieferzeiten-Management-System">
                Lieferzeiten-Management-System
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.syncConfiguration' }" title="Synchronisations-Einstellungen">
                Synchronisations-Einstellungen
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.taskAssignmentRules' }" :title="$tc('lieferzeiten.lms.navigation.taskAssignmentRules')">
                {{ $tc('lieferzeiten.lms.navigation.taskAssignmentRules') }}
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.notificationToggles' }" :title="$tc('lieferzeiten.lms.navigation.notificationToggles')">
                {{ $tc('lieferzeiten.lms.navigation.notificationToggles') }}
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.statistics' }" title="Statistiken">
                Statistiken
            </sw-tabs-item>
        </sw-tabs>

        <div class="lza-task-rule-layout">
            <sw-alert variant="info" appearance="notification" :showIcon="true">
                Die Demo-Daten in dieser Tabelle stammen aus dem Backend-Seeder
                <strong>DemoDataSeederService</strong> via l'endpoint
                <code>POST /api/_action/lieferzeiten/demo-data</code>.
                Demo-Regeln verwenden das Präfix <code>demo_</code>.
            </sw-alert>

            <section class="lza-rules-panel" :class="{ 'is-loading': isLoading }">
                <div class="lza-rules-toolbar">
                    <div>{{ total }} Regel(n)</div>
                    <sw-button size="small" @click="getList">Aktualisieren</sw-button>
                </div>

                <div v-if="!rules.length" class="lza-empty-state">
                    Keine Regeln gefunden. Bitte prüfen Sie, ob die Demo-Daten erfolgreich angelegt wurden.
                </div>

                <div v-else class="lza-rule-table" role="table" aria-label="Aufgaben-Zuweisungsregeln">
                    <div class="lza-rule-header" role="row">
                        <span>Name</span>
                        <span>Status</span>
                        <span>Trigger *</span>
                        <span>Regel</span>
                        <span>Zuweisungstyp *</span>
                        <span>Zuständig *</span>
                        <span>Priority</span>
                        <span>Aktiv</span>
                        <span>Zuletzt geändert</span>
                        <span>Aktionen</span>
                    </div>

                    <div v-for="rule in rules" :key="rule.id" class="lza-rule-row" role="row">
                        <input v-model="rule.name" type="text" :disabled="!hasEditAccess" />
                        <input v-model="rule.status" type="text" :disabled="!hasEditAccess" />
                        <input v-model="rule.triggerKey" type="text" required :disabled="!hasEditAccess" />
                        <input v-model="rule.ruleId" type="text" :disabled="!hasEditAccess" />
                        <input v-model="rule.assigneeType" type="text" required :disabled="!hasEditAccess" />
                        <input v-model="rule.assigneeIdentifier" type="text" required :disabled="!hasEditAccess" />
                        <input v-model.number="rule.priority" type="number" :disabled="!hasEditAccess" />
                        <label class="lza-checkbox-cell">
                            <input v-model="rule.active" type="checkbox" :disabled="!hasEditAccess" />
                            <span>{{ rule.active ? 'Ja' : 'Nein' }}</span>
                        </label>
                        <div class="lza-last-change">
                            <div>{{ formatDate(rule.lastChangedAt) }}</div>
                            <small>{{ rule.lastChangedBy || '—' }}</small>
                        </div>
                        <div class="lza-actions">
                            <sw-button size="small" variant="primary" :disabled="!hasEditAccess" @click="onSaveRule(rule)">Speichern</sw-button>
                            <sw-button size="small" variant="danger" :disabled="!hasEditAccess" @click="onDeleteRule(rule)">Löschen</sw-button>
                        </div>
                    </div>
                </div>

                <div class="lza-pagination">
                    <sw-button size="small" :disabled="page <= 1 || isLoading" @click="onPageChange({ page: page - 1, limit })">Zurück</sw-button>
                    <span>Seite {{ page }}</span>
                    <sw-button size="small" :disabled="(page * limit) >= total || isLoading" @click="onPageChange({ page: page + 1, limit })">Weiter</sw-button>
                </div>
            </section>
        </div>
    </template>
</sw-page>

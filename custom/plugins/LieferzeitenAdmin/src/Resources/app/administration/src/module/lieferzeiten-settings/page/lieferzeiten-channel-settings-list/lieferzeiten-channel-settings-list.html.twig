<sw-page class="lieferzeiten-channel-settings-list">
    <template #smart-bar-header>
        <h2>{{ $tc('lieferzeiten.lms.dashboard.title') }}</h2>
    </template>

    <template #smart-bar-actions>
        <button v-if="hasEditAccess" class="lza-btn lza-btn--primary" :disabled="isSaving" @click="onSave">
            {{ isSaving ? 'Saving…' : $tc('global.default.save') }}
        </button>
    </template>

    <template #content>
        <div class="lza-settings-nav">
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.channelSettings' }" :to="{ name: 'lieferzeiten.settings.channelSettings' }">Lieferzeiten-Management-System</router-link>
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.syncConfiguration' }" :to="{ name: 'lieferzeiten.settings.syncConfiguration' }">Sync settings</router-link>
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.taskAssignmentRules' }" :to="{ name: 'lieferzeiten.settings.taskAssignmentRules' }">{{ $tc('lieferzeiten.lms.navigation.taskAssignmentRules') }}</router-link>
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.notificationToggles' }" :to="{ name: 'lieferzeiten.settings.notificationToggles' }">{{ $tc('lieferzeiten.lms.navigation.notificationToggles') }}</router-link>
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.statistics' }" :to="{ name: 'lieferzeiten.settings.statistics' }">Statistiken</router-link>
        </div>

        <div class="lza-settings-layout" :class="{ 'is-loading': isLoading }">
            <section v-if="isIndexRoute" class="lza-panel lza-panel--compact">
                <h3>API / Token / SAN6</h3>
                <div class="lza-field-grid">
                    <label v-for="field in apiConfigFields" :key="field.key" class="lza-field">
                        <span>{{ field.label }}</span>
                        <input v-model="apiConfigValues[field.key]" :type="field.type === 'password' ? 'password' : 'text'" />
                    </label>
                </div>
            </section>

            <section v-if="isChannelSettingsRoute" class="lza-panel">
                <h3>{{ $tc('lieferzeiten.lms.dashboard.cardTitle') }}</h3>
                <p class="lza-hint">{{ $tc('lieferzeiten.lms.dashboard.introText') }}</p>

                <p v-if="hasValidationErrors" class="lza-warning">{{ $tc('lieferzeiten.lms.dashboard.validationError') }}</p>

                <section v-for="group in groupedChannels" :key="group.id" class="lza-channel-group">
                    <h4>{{ group.title }}</h4>

                    <div class="lza-chip-row">
                        <button
                            v-for="channel in group.channels"
                            :key="`${group.id}-${channel.id}`"
                            class="lza-chip"
                            :class="{ 'is-active': getSelectedChannelId(group.id) === channel.id }"
                            @click="onSelectChannel(group.id, channel.id)"
                        >
                            {{ channel.name || channel.id }}
                        </button>
                    </div>

                    <template v-if="getActiveChannel(group)">
                        <div class="lza-channel-header">
                            <h5>{{ getActiveChannel(group).name || getActiveChannel(group).id }}</h5>
                            <span v-if="hasIncompletePdmsMapping(getActiveChannel(group).id)" class="lza-badge">{{ $tc('lieferzeiten.lms.dashboard.incompleteMappingBadge') }}</span>
                        </div>

                        <p v-if="hasIncompletePdmsMapping(getActiveChannel(group).id)" class="lza-warning">
                            {{ $t('lieferzeiten.lms.dashboard.incompleteMappingWarning', { channelName: getActiveChannel(group).name || getActiveChannel(group).id }) }}
                        </p>

                        <div class="lza-table-wrap">
                            <table class="lza-table">
                                <thead>
                                    <tr>
                                        <th>{{ $tc('lieferzeiten.lms.dashboard.columns.pdmsLieferzeit') }}</th>
                                        <th>{{ $tc('lieferzeiten.lms.dashboard.columns.shippingOverdueWorkingDays') }}</th>
                                        <th>{{ $tc('lieferzeiten.lms.dashboard.columns.deliveryOverdueWorkingDays') }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="item in getChannelPdmsLieferzeiten(getActiveChannel(group).id)" :key="item.key">
                                        <td>{{ item.label }}</td>
                                        <td>
                                            <input
                                                type="number"
                                                min="0"
                                                :disabled="!hasEditAccess"
                                                :value="getMatrixValue(getActiveChannel(group).id, item.key, 'shippingOverdueWorkingDays')"
                                                @input="onChangeNumberField(getActiveChannel(group).id, item.key, 'shippingOverdueWorkingDays', Number($event.target.value))"
                                            >
                                        </td>
                                        <td>
                                            <input
                                                type="number"
                                                min="0"
                                                :disabled="!hasEditAccess"
                                                :value="getMatrixValue(getActiveChannel(group).id, item.key, 'deliveryOverdueWorkingDays')"
                                                @input="onChangeNumberField(getActiveChannel(group).id, item.key, 'deliveryOverdueWorkingDays', Number($event.target.value))"
                                            >
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </template>
                </section>
            </section>
        </div>
    </template>
</sw-page>

<sw-page class="lieferzeiten-notification-toggle-list">
    <template #smart-bar-header>
        <h2>{{ $t('lieferzeiten.lms.navigation.notificationToggles') }}</h2>
    </template>

    <template #content>
        <div class="lza-settings-nav">
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.channelSettings' }" :to="{ name: 'lieferzeiten.settings.channelSettings' }">Lieferzeiten-Management-System</router-link>
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.syncConfiguration' }" :to="{ name: 'lieferzeiten.settings.syncConfiguration' }">Sync settings</router-link>
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.taskAssignmentRules' }" :to="{ name: 'lieferzeiten.settings.taskAssignmentRules' }">{{ $tc('lieferzeiten.lms.navigation.taskAssignmentRules') }}</router-link>
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.notificationToggles' }" :to="{ name: 'lieferzeiten.settings.notificationToggles' }">{{ $tc('lieferzeiten.lms.navigation.notificationToggles') }}</router-link>
            <router-link class="lza-settings-nav__item" :class="{ 'is-active': $route.name === 'lieferzeiten.settings.statistics' }" :to="{ name: 'lieferzeiten.settings.statistics' }">Statistiken</router-link>
        </div>

        <section class="lza-notify-panel" :class="{ 'is-loading': isLoading }">
            <h3>{{ $t('lieferzeiten.lms.notificationMatrix.title') }}</h3>
            <p class="lza-note">{{ $t('lieferzeiten.lms.notificationMatrix.source') }} <code>(triggerKey, channel, salesChannelId)</code>.</p>
            <p class="lza-note">{{ $t('lieferzeiten.lms.notificationMatrix.emailOnlyHint') }}</p>
            <p v-if="invalidEntries.length" class="lza-warning">{{ $t('lieferzeiten.lms.notificationMatrix.invalidEntries', { count: invalidEntries.length }) }}</p>

            <div class="lieferzeiten-notification-toggle-list__toolbar">
                <label class="lieferzeiten-notification-toggle-list__filter-wrap">
                    <span>{{ $t('lieferzeiten.lms.notificationMatrix.salesChannelFilterLabel') }}</span>
                    <select v-model="selectedSalesChannelId" class="lieferzeiten-notification-toggle-list__filter">
                        <option v-for="option in salesChannelFilterOptions" :key="option.value" :value="option.value">{{ option.label }}</option>
                    </select>
                </label>

                <button class="lza-btn lza-btn--primary" :disabled="isLoading" @click="onReload">{{ $t('lieferzeiten.lms.notificationMatrix.reload') }}</button>
            </div>

            <div class="lieferzeiten-notification-toggle-list__scope-grid">
                <article v-for="scope in visibleScopes" :key="scope.id" class="lieferzeiten-notification-toggle-list__scope-card">
                    <div class="lieferzeiten-notification-toggle-list__scope-head">
                        <h4>{{ scope.name }}</h4>
                        <div class="lieferzeiten-notification-toggle-list__quick-actions">
                            <button class="lza-btn lza-btn--primary" :disabled="isLoading || !hasEditAccess" @click="setScopeState(scope.id, true)">{{ $t('lieferzeiten.lms.notificationMatrix.enableAll') }}</button>
                            <button class="lza-btn" :disabled="isLoading || !hasEditAccess" @click="setScopeState(scope.id, false)">{{ $t('lieferzeiten.lms.notificationMatrix.disableAll') }}</button>
                        </div>
                    </div>

                    <div class="lieferzeiten-notification-toggle-list__trigger-list">
                        <label
                            v-for="triggerKey in triggerOptions"
                            :key="`${scope.id}-${triggerKey}`"
                            class="lieferzeiten-notification-toggle-list__trigger-item"
                        >
                            <span class="lieferzeiten-notification-toggle-list__trigger-label">{{ getTriggerLabel(triggerKey) }}</span>
                            <input
                                type="checkbox"
                                :checked="getToggleValue(triggerKey, channelOptions[0], scope.id === 'global' ? null : scope.id)"
                                :disabled="!hasEditAccess || isCellDisabled(triggerKey, channelOptions[0], scope.id === 'global' ? null : scope.id)"
                                @change="onToggleChanged(triggerKey, channelOptions[0], scope.id === 'global' ? null : scope.id, $event.target.checked)"
                            >
                        </label>
                    </div>
                </article>
            </div>
        </section>
    </template>
</sw-page>

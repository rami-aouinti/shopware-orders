<sw-page class="lieferzeiten-notification-toggle-list">
    <template #smart-bar-header>
        <h2>{{ $t('lieferzeiten.lms.navigation.notificationToggles') }}</h2>
    </template>

    <template #content>
        <sw-tabs class="sw-mb-16">
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.channelSettings' }" title="Lieferzeiten-Management-System">
                Lieferzeiten-Management-System
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.syncConfiguration' }" title="Sync settings">
                Sync settings
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.taskAssignmentRules' }" :title="$t('lieferzeiten.lms.navigation.taskAssignmentRules')">
                {{ $t('lieferzeiten.lms.navigation.taskAssignmentRules') }}
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.notificationToggles' }" :title="$t('lieferzeiten.lms.navigation.notificationToggles')">
                {{ $t('lieferzeiten.lms.navigation.notificationToggles') }}
            </sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.statistics' }" title="Statistiken">
                Statistiken
            </sw-tabs-item>
        </sw-tabs>
        <sw-card :isLoading="isLoading" :title="$t('lieferzeiten.lms.notificationMatrix.title')">
            <sw-alert variant="info" appearance="default" :showIcon="true">
                {{ $t('lieferzeiten.lms.notificationMatrix.source') }}
                <code>(triggerKey, channel, salesChannelId)</code>.
            </sw-alert>

            <sw-alert variant="info" appearance="default" :showIcon="true">
                {{ $t('lieferzeiten.lms.notificationMatrix.emailOnlyHint') }}
            </sw-alert>

            <sw-alert v-if="invalidEntries.length" variant="warning" appearance="default" :showIcon="true">
                {{ $t('lieferzeiten.lms.notificationMatrix.invalidEntries', { count: invalidEntries.length }) }}
            </sw-alert>

            <div class="sw-data-grid sw-data-grid--compact lieferzeiten-notification-toggle-list__grid">
                <table class="sw-data-grid__table lieferzeiten-notification-toggle-list__table">
                    <thead class="sw-data-grid__header">
                        <tr class="sw-data-grid__row">
                            <th class="sw-data-grid__cell lieferzeiten-notification-toggle-list__header-cell lieferzeiten-notification-toggle-list__header-cell--label">{{ $t('lieferzeiten.lms.notificationMatrix.notificationType') }}</th>
                            <th
                                v-for="scope in salesChannelColumns"
                                :key="scope.id"
                                class="sw-data-grid__cell lieferzeiten-notification-toggle-list__header-cell"
                            >
                                <span class="lieferzeiten-notification-toggle-list__header-title">{{ scope.name }}</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sw-data-grid__body">
                        <tr
                            v-for="triggerKey in triggerOptions"
                            :key="triggerKey"
                            class="sw-data-grid__row"
                        >
                            <td class="sw-data-grid__cell lieferzeiten-notification-toggle-list__trigger-cell"><strong>{{ getTriggerLabel(triggerKey) }}</strong></td>
                            <td
                                v-for="scope in salesChannelColumns"
                                :key="`${triggerKey}-${scope.id}`"
                                class="sw-data-grid__cell lieferzeiten-notification-toggle-list__cell"
                            >
                                <div
                                    v-for="channel in channelOptions"
                                    :key="`${triggerKey}-${scope.id}-${channel}`"
                                    class="lieferzeiten-notification-toggle-list__channel-row"
                                >
                                    <sw-switch-field
                                        :value="getToggleValue(triggerKey, channel, scope.id === 'global' ? null : scope.id)"
                                        :disabled="!hasEditAccess || isCellDisabled(triggerKey, channel, scope.id === 'global' ? null : scope.id)"
                                        @update:value="onToggleChanged(triggerKey, channel, scope.id === 'global' ? null : scope.id, $event)"
                                    />
                                    <span class="lieferzeiten-notification-toggle-list__channel-label">{{ channel }}</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </sw-card>
    </template>
</sw-page>

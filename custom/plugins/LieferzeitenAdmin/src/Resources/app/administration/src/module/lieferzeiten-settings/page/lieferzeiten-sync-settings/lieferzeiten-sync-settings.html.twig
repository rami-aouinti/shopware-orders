<sw-page class="lieferzeiten-sync-settings">
    <template #smart-bar-header>
        <h2>Lieferzeiten sync settings</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button-process variant="primary" :isLoading="isSaving" @click="onSave">
            {{ $tc('global.default.save') }}
        </sw-button-process>
    </template>

    <template #content>
        <sw-card-view>
            <sw-card
                v-for="group in groups"
                :key="group.title"
                :title="group.title"
                :isLoading="isLoading"
                class="sw-mb-16"
            >
                <template v-for="field in group.fields">
                    <sw-textarea-field
                        v-if="field.type === 'textarea'"
                        :key="field.key"
                        v-model:value="configValues[field.key]"
                        :label="field.label"
                        :helpText="field.helpText"
                        class="sw-mb-16"
                    />

                    <sw-password-field
                        v-else-if="field.type === 'password'"
                        :key="field.key"
                        v-model:value="configValues[field.key]"
                        :label="field.label"
                        :helpText="field.helpText"
                        class="sw-mb-16"
                    />

                    <sw-text-field
                        v-else
                        :key="field.key"
                        v-model:value="configValues[field.key]"
                        :label="field.label"
                        :helpText="field.helpText"
                        class="sw-mb-16"
                    />
                </template>
            </sw-card>
        </sw-card-view>
    </template>
</sw-page>

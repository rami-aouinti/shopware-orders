<sw-page class="lieferzeiten-sync-settings">
    <template #smart-bar-header>
        <h2>Lieferzeiten sync settings</h2>
    </template>

    <template #smart-bar-actions>
        <button class="lza-btn lza-btn--primary" :disabled="isSaving" @click="onSave">
            {{ isSaving ? 'Saving…' : $tc('global.default.save') }}
        </button>
    </template>

    <template #content>
        <sw-tabs class="sw-mb-16">
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.channelSettings' }" title="Lieferzeiten-Management-System">Lieferzeiten-Management-System</sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.syncConfiguration' }" title="Sync settings">Sync settings</sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.taskAssignmentRules' }" :title="$tc('lieferzeiten.lms.navigation.taskAssignmentRules')">{{ $tc('lieferzeiten.lms.navigation.taskAssignmentRules') }}</sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.notificationToggles' }" :title="$tc('lieferzeiten.lms.navigation.notificationToggles')">{{ $tc('lieferzeiten.lms.navigation.notificationToggles') }}</sw-tabs-item>
            <sw-tabs-item :route="{ name: 'lieferzeiten.settings.statistics' }" title="Statistiken">Statistiken</sw-tabs-item>
        </sw-tabs>

        <div class="lza-sync-layout" :class="{ 'is-loading': isLoading }">
            <section class="lza-sync-card lza-sync-card--demo">
                <h3>Demo Daten</h3>
                <lieferzeiten-demo-data-button />
            </section>

            <section v-for="group in groups" :key="group.title" class="lza-sync-card">
                <h3>{{ group.title }}</h3>

                <label v-for="field in group.fields" :key="field.key" class="lza-sync-field">
                    <span>{{ field.label }}</span>
                    <small v-if="field.helpText">{{ field.helpText }}</small>
                    <textarea v-if="field.type === 'textarea'" v-model="configValues[field.key]" rows="4"></textarea>
                    <input v-else :type="field.type === 'password' ? 'password' : 'text'" v-model="configValues[field.key]">
                </label>
            </section>
        </div>
    </template>
</sw-page>

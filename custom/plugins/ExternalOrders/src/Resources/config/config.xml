<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/platform/trunk/src/Core/System/SystemConfig/Schema/config.xsd">
    <card>
        <title lang="en-GB">External Orders</title>
        <title lang="de-DE">Externe Bestellungen</title>

        <input-field type="text">
            <name>externalOrdersPageTitle</name>
            <label lang="en-GB">External Orders title</label>
            <label lang="de-DE">Titel für External Orders</label>
            <defaultValue>Bestellübersichten</defaultValue>
        </input-field>

        <input-field type="int">
            <name>externalOrdersPerPage</name>
            <label lang="en-GB">Orders per page</label>
            <label lang="de-DE">Anzahl pro Seite</label>
            <defaultValue>25</defaultValue>
        </input-field>

        <component name="external-orders-testdata-button">
            <name>externalOrdersDemoData</name>
            <label lang="en-GB">Demo data</label>
            <label lang="de-DE">Demo-Daten</label>
        </component>

        <input-field type="text">
            <name>supplierRequestRecipientUserId</name>
            <label lang="en-GB">Recipient user ID for supplier requests</label>
            <label lang="de-DE">Empfänger User-ID für Liefertermin-Anfragen</label>
            <helpText lang="en-GB">If empty, the initiator is used as recipient.</helpText>
            <helpText lang="de-DE">Wenn leer, wird der Initiator als Empfänger verwendet.</helpText>
        </input-field>

    </card>
</config>

<sw-page class="external-orders-settings">
    <template #smart-bar-header>
        <h2>Externe Bestellung</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button-process variant="primary" :isLoading="isSaving" @click="onSave">
            {{ $tc('global.default.save') }}
        </sw-button-process>
    </template>

    <template #content>
        <sw-card-view>
            <sw-card :isLoading="isLoading" title="API & Kanäle">
                <external-orders-channel-config />
            </sw-card>

            <sw-card :isLoading="isLoading" title="Technische Einstellungen">
                <sw-text-field
                    v-model:value="config.externalOrdersTimeout"
                    label="External Orders API timeout (seconds)"
                />
            </sw-card>

            <sw-card :isLoading="isLoading" title="SAN6 Konfiguration">
                <sw-text-field v-model:value="config.externalOrdersSan6BaseUrl" label="SAN6 base URL" placeholder="https://example.com:4443" />
                <sw-text-field v-model:value="config.externalOrdersSan6Company" label="SAN6 company" />
                <sw-text-field v-model:value="config.externalOrdersSan6Product" label="SAN6 product" />
                <sw-select-field v-model:value="config.externalOrdersSan6Mandant" label="SAN6 mandant">
                    <option value="Schule">Schule</option>
                    <option value="Zentrale">Zentrale</option>
                </sw-select-field>
                <sw-text-field v-model:value="config.externalOrdersSan6Sys" label="SAN6 sys" />
                <sw-text-field v-model:value="config.externalOrdersSan6Authentifizierung" label="SAN6 authentification" />
                <sw-text-field v-model:value="config.externalOrdersSan6ReadFunction" label="SAN6 read function" />
                <sw-text-field v-model:value="config.externalOrdersSan6WriteFunction" label="SAN6 write function" />
                <sw-select-field v-model:value="config.externalOrdersSan6SendStrategy" label="SAN6 send strategy">
                    <option value="filetransferurl">filetransferurl</option>
                    <option value="post-xml">post-xml</option>
                </sw-select-field>
            </sw-card>
        </sw-card-view>
    </template>
</sw-page>

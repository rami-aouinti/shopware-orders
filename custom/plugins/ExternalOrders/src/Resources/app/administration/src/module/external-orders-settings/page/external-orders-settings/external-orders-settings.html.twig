<sw-page class="external-orders-settings">
    <template #smart-bar-header>
        <h2>LieferzeitAdmin · SAN6 Konfiguration</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button-process variant="primary" :isLoading="isSaving" @click="onSave">
            {{ $tc('global.default.save') }}
        </sw-button-process>
    </template>

    <template #content>
        <sw-card-view>
            <sw-card :isLoading="isLoading" title="SAN6 / LieferzeitAdmin">
                <sw-text-field
                    v-model:value="config.externalOrdersSan6BaseUrl"
                    label="SAN6 API URL"
                    placeholder="https://..."
                />
                <sw-text-field
                    v-model:value="config.externalOrdersSan6Authentifizierung"
                    label="SAN6 API Token"
                    class="sw-mt-16"
                />
                <sw-single-select
                    v-model:value="config.externalOrdersSan6SendStrategy"
                    label="SAN6 Sende-Strategie"
                    class="sw-mt-16"
                    :options="san6SendStrategyOptions"
                />
                <sw-text-field
                    v-model:value="config.externalOrdersSan6ReadFunction"
                    label="SAN6 Read Function"
                    class="sw-mt-16"
                />
                <sw-text-field
                    v-model:value="config.externalOrdersSan6WriteFunction"
                    label="SAN6 Write Function"
                    class="sw-mt-16"
                />
                <sw-text-field
                    v-model:value="config.externalOrdersSan6Company"
                    label="SAN6 Company"
                    class="sw-mt-16"
                />
                <sw-text-field
                    v-model:value="config.externalOrdersSan6Product"
                    label="SAN6 Product"
                    class="sw-mt-16"
                />
                <sw-text-field
                    v-model:value="config.externalOrdersSan6Mandant"
                    label="SAN6 Mandant"
                    class="sw-mt-16"
                />
                <sw-text-field
                    v-model:value="config.externalOrdersSan6Sys"
                    label="SAN6 Sys"
                    class="sw-mt-16"
                />
                <sw-text-field
                    v-model:value="config.externalOrdersSan6ReadKopf"
                    label="SAN6 Read Kopf"
                    class="sw-mt-16"
                    placeholder="2"
                />
                <sw-text-field
                    v-model:value="config.externalOrdersSan6ReadKundennummer"
                    label="SAN6 Read Kundennummer"
                    class="sw-mt-16"
                    placeholder="3801182"
                />
                <sw-text-field
                    v-model:value="config.externalOrdersSan6ReadFromDate"
                    label="SAN6 Read Von"
                    class="sw-mt-16"
                    placeholder="16.06.2025"
                />
            </sw-card>
        </sw-card-view>
    </template>
</sw-page>

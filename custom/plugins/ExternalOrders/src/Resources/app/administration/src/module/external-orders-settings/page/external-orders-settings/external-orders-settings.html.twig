<sw-page class="external-orders-settings">
    <template #smart-bar-header>
        <h2>Externe Bestellung</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button-process variant="primary" :isLoading="isSaving" @click="onSave">
            {{ $tc('global.default.save') }}
        </sw-button-process>
    </template>

    <template #content>
        <sw-card-view>
            <sw-card :isLoading="isLoading" title="Externe Bestellung">
                <sw-number-field
                    v-model:value="config.externalOrdersItemsPerPage"
                    numberType="int"
                    :min="1"
                    :step="1"
                    label="Nombre par page"
                />

                <external-orders-testdata-button class="sw-mt-16" />
            </sw-card>
        </sw-card-view>
    </template>
</sw-page>

<div class="external-orders-lieferzeit-empty">
    <header class="external-orders-lieferzeit-empty__header">
        <div>
            <p class="external-orders-lieferzeit-empty__eyebrow">Lieferzeitenmonitoring</p>
            <h2>{{ pageTitle }}</h2>
        </div>
        <div class="external-orders-lieferzeit-empty__active-channel">
            <span>Aktiver Kanal</span>
            <strong>{{ activeChannelLabel }}</strong>
        </div>
    </header>

    <div class="external-orders-lieferzeit-empty__summary">
        <div class="external-orders-lieferzeit-empty__summary-item">
            <span>Offene Aufträge</span>
            <strong>{{ statisticsMetrics.openOrders }}</strong>
        </div>
        <div class="external-orders-lieferzeit-empty__summary-item">
            <span>Versand überfällig</span>
            <strong>{{ statisticsMetrics.overdueShipping }}</strong>
        </div>
        <div class="external-orders-lieferzeit-empty__summary-item">
            <span>Lieferung überfällig</span>
            <strong>{{ statisticsMetrics.overdueDelivery }}</strong>
        </div>
    </div>

    <sw-card>
        <div class="external-orders-lieferzeit-empty__channel-tabs">
            <button
                v-for="channel in channels"
                :key="channel.id"
                class="external-orders-lieferzeit-empty__channel-tab"
                :class="{ 'is--active': activeChannel === channel.id }"
                type="button"
                @click="onChannelChange(channel.id)"
            >
                {{ channel.label }}
            </button>
        </div>

        <lieferzeiten-order-table
            :orders="orders"
            :on-reload-order="handleReloadOrder"
            row-mode="position"
        />
    </sw-card>
</div>
